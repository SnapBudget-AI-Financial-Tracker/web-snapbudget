// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  password              String?
  googleId              String?       @unique
  name                  String?
  avatarUrl             String?
  budgetBulanan         Int           @default(2000000)
  budgetMakanan         Int           @default(700000)
  budgetMinuman         Int           @default(200000)
  budgetTransportasi    Int           @default(300000)
  budgetBelanja         Int           @default(200000)
  budgetTagihan         Int           @default(240000)
  budgetHiburan         Int           @default(160000)
  budgetKesehatan       Int           @default(100000)
  budgetLainLain        Int           @default(100000)
  tanggalGajian         Int           @default(25)
  targetTabungan        Int           @default(0)
  isOnboardingComplete  Boolean       @default(false)
  resetToken            String?       @unique
  resetTokenExpiry      DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  transactions          Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  receiptUrl  String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
